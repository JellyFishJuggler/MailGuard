# Copy this to .env and fill in whichever keys you have.
# The agent picks the first provider that works, in this order:
# ollama -> openai -> gemini -> grok

# Local ollama, no key needed, just have the server running
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hermes3:latest

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Grok by xAI
XAI_API_KEY=
GROK_MODEL=grok-2-latest

# Where the sqlite database lives
MAILGUARD_DB=email.db
